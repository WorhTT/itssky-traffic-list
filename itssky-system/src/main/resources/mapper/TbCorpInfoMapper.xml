<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itssky.system.mapper.TbCorpInfoMapper">
  <resultMap id="BaseResultMap" type="com.itssky.system.domain.TbCorpInfo">
    <!--@mbg.generated-->
    <!--@Table tbcorpinfo-->
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="corpno" jdbcType="VARCHAR" property="corpno" />
    <result column="corpname" jdbcType="VARCHAR" property="corpname" />
    <result column="corpshort" jdbcType="VARCHAR" property="corpshort" />
    <result column="corpid" jdbcType="INTEGER" property="corpid" />
    <result column="ownerid" jdbcType="INTEGER" property="ownerid" />
    <result column="ownername" jdbcType="VARCHAR" property="ownername" />
    <result column="level" jdbcType="INTEGER" property="level" />
    <result column="indexno" jdbcType="INTEGER" property="indexno" />
    <result column="spare1" jdbcType="INTEGER" property="spare1" />
    <result column="spare2" jdbcType="VARCHAR" property="spare2" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    id, corpno, corpname, corpshort, corpid, ownerid, ownername, `level`, indexno, spare1, 
    spare2
  </sql>

  <resultMap type="com.itssky.system.domain.TbCorpInfo" id="TbCorpInfoResult">
    <result property="id"    column="id"    />
    <result property="corpno"    column="corpno"    />
    <result property="corpname"    column="corpname"    />
    <result property="corpshort"    column="corpshort"    />
    <result property="corpid"    column="corpid"    />
    <result property="ownerid"    column="ownerid"    />
    <result property="ownername"    column="ownername"    />
    <result property="level"    column="level"    />
    <result property="indexno"    column="indexno"    />
    <result property="spare1"    column="spare1"    />
    <result property="spare2"    column="spare2"    />
  </resultMap>

  <sql id="selectTbCorpInfoVo">
    select id, corpno, corpname, corpshort, corpid, ownerid, ownername, level, indexno, spare1, spare2 from tbcorpinfo
  </sql>

  <select id="selectTbCorpInfoList" parameterType="com.itssky.system.domain.TbCorpInfo" resultMap="TbCorpInfoResult">
    <include refid="selectTbCorpInfoVo"/>
    <where>
      and corpno is not null and corpno != '' and Length(corpno) <![CDATA[<=]]> 4
      <if test="corpname != null  and corpname != ''"> and corpname like concat('%', #{corpname}, '%')</if>
      <if test="corpno != null  and corpno != ''"> and corpno = #{corpno}</if>
    </where>
  </select>

  <select id="selectTbCorpInfoListForTree" parameterType="com.itssky.system.domain.TbCorpInfo" resultMap="TbCorpInfoResult">
    select id, corpno, corpname, level from tbcorpinfo
    <where>
      and corpno is not null and corpno != '' and Length(corpno) <![CDATA[<=]]> 4
      <if test="corpname != null  and corpname != ''"> and corpname like concat('%', #{corpname}, '%')</if>
      <if test="corpNoList != null and corpNoList.size() != 0">
        and corpno IN
        <foreach collection="corpNoList" item="item" open="(" close=")" separator=",">
          #{item}
        </foreach>
      </if>
      <if test="corpno != null and corpno != ''">
        and corpno  LIKE CONCAT (#{corpno},'%')
      </if>
    </where>
  </select>
</mapper>